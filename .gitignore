.venv/
__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/

# Evidence from a real tenant never enters this repository. Fixtures are
# fabricated on purpose: they carry the shape of the data, not the data.
evidence/
*.tenant.json

# A binary that changes on every run and tells a reader nothing.
.coverage
htmlcov/
.DS_Store

# Standalone engine builds. Made by tools/build-standalone.sh, never committed.
/build/

# The local run store. A runtime artefact of `m365g`, written beside the
# package when a run is started from a checkout. Never committed: it is machine
# state, and a populated one would carry a tenant.
src/m365_governance/data/workspace.db
