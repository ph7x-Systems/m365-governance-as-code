  "gaps": [
    {
      "question": "Does a property being present on the type mean -Includes will accept it?",
      "state": "unverified",
      "detail": "Presence is necessary and has not been shown to be sufficient. -Includes is translated into a CSOM load expression, and a property the server does not project may be on the type and still be rejected. This recording therefore catches names that are absent, which is the failure that actually happened, and does not certify names that are present."
    }
  ]
}
