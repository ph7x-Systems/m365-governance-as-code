          "results": [
            {
              "rule_id": "SPO-CLASS-001",
              "title": "This site carries no sensitivity label and no classification",
              "rule_version": "1.0",
              "schema_version": "1.0",
              "resource": {
                "workload": "sharepoint",
                "type": "site",
                "native_id": "contoso,site,group-unlabelled"
              },
              "outcome": "fail",
              "message": "This site carries neither a sensitivity label nor a classification string. Nothing recorded on it says what kind of content it holds.",
              "basis": "documented-guidance",
              "severity": "low",
              "evidence_used": [
                {
                  "path": "classification.classified",
                  "state": "observed",
                  "value": false,
                  "lower_bound": null,
                  "upper_bound": null,
                  "detail": null
                }
              ],
              "passes_without_resolving": "Any label passes. A site labelled Public and a site labelled Highly Confidential are indistinguishable to this rule, and so is a site labelled with whatever came first in the dropdown. It reports that the question was answered, never that the answer was right.",
              "sources": [
                {
                  "url": "https://learn.microsoft.com/purview/deploymentmodels/depmod-secure-by-default-step3",
                  "title": "Secure by default with Microsoft Purview, Step 3: expand to your entire Microsoft 365 data estate",
                  "publisher": "Microsoft",
                  "checked_at": "2026-08-06"
                },
                {
                  "url": "https://learn.microsoft.com/purview/sensitivity-labels-teams-groups-sites",
                  "title": "Use sensitivity labels to protect collaborative workspaces (groups and sites)",
                  "publisher": "Microsoft",
                  "checked_at": "2026-08-06"
                }
              ],
              "remediation": "Decide first whether the tenant is using container labels at all. If it is not, every site will fail this rule and the finding to act on is the tenant decision, not the site. If it is, the deployment model Microsoft publishes works outward from the sites that matter most rather than through the list in order, and this rule set can produce that list but cannot rank it.",
              "message_degraded": false,
              "engine_detail": "",
              "attention": {
                "state": "review",
                "rank": 4,
                "because": [
                  "the rule failed against a documented-guidance, which is a choice to weigh rather than a documented violation"
                ]
              }
            },
            {
              "rule_id": "SPO-CLASS-002",
              "title": "This site carries a sensitivity label that could not be resolved to a name",
              "rule_version": "1.0",
              "schema_version": "1.0",
              "resource": {
                "workload": "sharepoint",
                "type": "site",
                "native_id": "contoso,site,group-unlabelled"
              },
              "outcome": "not-applicable",
              "message": "No sensitivity label is applied to this site, so there is nothing to resolve. Whether it should carry one is SPO-CLASS-001.",
              "basis": "convention",
              "severity": "low",
              "evidence_used": [
                {
                  "path": "classification.label_applied",
                  "state": "observed",
                  "value": false,
                  "lower_bound": null,
                  "upper_bound": null,
                  "detail": null
                },
                {
                  "path": "classification.label_resolved",
                  "state": "missing",
                  "value": null,
                  "lower_bound": null,
                  "upper_bound": null,
                  "detail": "No label is applied, so there is nothing to resolve."
                }
              ],
              "passes_without_resolving": "A resolved name passes, and a name is a word. It says nothing about what the label is configured to do: privacy, guest access, the default sharing link and conditional access are all label settings this rule never reads. A site labelled Confidential by a label that enforces nothing passes.",
              "sources": [
                {
                  "url": "https://learn.microsoft.com/purview/sensitivity-labels-teams-groups-sites",
                  "title": "Use sensitivity labels to protect collaborative workspaces (groups and sites)",
                  "publisher": "Microsoft",
                  "checked_at": "2026-08-06"
                }
              ],
              "remediation": "Nothing on the site needs changing. Either the identity that collected the evidence cannot read label definitions, in which case collect again with one that can, or the label was deleted in Purview and the sites still carry its id, in which case the label is the thing to fix and it will be carrying more sites than this one.",
              "message_degraded": false,
              "engine_detail": "",
              "attention": {
                "state": "none",
                "rank": 5,
                "because": [
                  "the rule does not apply to this resource"
                ]
              }
            },
            {
              "rule_id": "SPO-CLASS-003",
              "title": "This group-connected site carries no sensitivity label",
              "rule_version": "1.0",
              "schema_version": "1.0",
              "resource": {
                "workload": "sharepoint",
                "type": "site",
                "native_id": "contoso,site,group-unlabelled"
              },
              "outcome": "fail",
              "message": "This site is connected to a Microsoft 365 group and carries no sensitivity label. Privacy and external user access rest on the settings of the group itself, and nothing pins them. A classification string does not pin a group's access.",
              "basis": "convention",
              "severity": "medium",
              "evidence_used": [
                {
                  "path": "classification.group_connected",
                  "state": "observed",
                  "value": true,
                  "lower_bound": null,
                  "upper_bound": null,
                  "detail": null
                },
                {
                  "path": "classification.label_applied",
                  "state": "observed",
                  "value": false,
                  "lower_bound": null,
                  "upper_bound": null,
                  "detail": null
                }
              ],
              "passes_without_resolving": "Any label passes, including one configured to set nothing. A label whose protection settings were left empty leaves privacy and guest access exactly where this rule found them and satisfies it completely.",
              "sources": [
                {
                  "url": "https://learn.microsoft.com/purview/sensitivity-labels-teams-groups-sites",
                  "title": "Use sensitivity labels to protect collaborative workspaces (groups and sites)",
                  "publisher": "Microsoft",
                  "checked_at": "2026-08-06"
                },
                {
                  "url": "https://learn.microsoft.com/entra/architecture/8-secure-access-sensitivity-labels",
                  "title": "Control external access to resources in Microsoft Entra ID with sensitivity labels",
                  "publisher": "Microsoft",
                  "checked_at": "2026-08-06"
                }
              ],
              "remediation": "Read the group settings before applying anything. A label sets privacy and external access and locks them, so applying one to a group that is currently configured differently changes the group. That is the point of it and it is also how a labelling exercise removes somebody's access on a Tuesday afternoon.",
              "message_degraded": false,
              "engine_detail": "",
              "attention": {
                "state": "review",
                "rank": 4,
                "because": [
                  "the rule failed against a convention, which is a choice to weigh rather than a documented violation"
                ]
              }
            },
            {
              "rule_id": "SPO-CLASS-004",
              "title": "A classification string is doing a label's job",
              "rule_version": "1.0",
              "schema_version": "2.0",
              "resource": {
                "workload": "sharepoint",
                "type": "site",
                "native_id": "contoso,site,group-unlabelled"
              },
              "outcome": "not-applicable",
              "message": "This site carries no classic classification string, so there is no string doing a label's job here. Whether the site should carry a label at all is SPO-CLASS-001's question.",
              "basis": "documented-guidance",
              "severity": "low",
              "evidence_used": [
                {
                  "path": "classification.classification_set",
                  "state": "observed",
                  "value": false,
                  "lower_bound": null,
                  "upper_bound": null,
                  "detail": null
                },
                {
                  "path": "classification.label_applied",
                  "state": "observed",
                  "value": false,
                  "lower_bound": null,
                  "upper_bound": null,
                  "detail": null
                }
              ],
              "passes_without_resolving": "Any label passes. A site whose label carries none of the protections the old string was meant to imply passes this rule exactly like one whose label enforces all of them: the rule reads that a label is applied, never what the label does.",
              "sources": [
                {
                  "url": "https://learn.microsoft.com/sharepoint/dev/solution-guidance/modern-experience-site-classification",
                  "title": "SharePoint \"modern\" sites classification",
                  "publisher": "Microsoft",
                  "checked_at": "2026-08-11"
                },
                {
                  "url": "https://learn.microsoft.com/purview/sensitivity-labels-teams-groups-sites",
                  "title": "Use sensitivity labels to protect collaborative workspaces",
                  "publisher": "Microsoft",
                  "checked_at": "2026-08-11"
                }
              ],
              "remediation": "Convert the classification value to a sensitivity label with the settings the string was standing in for, following Microsoft's conversion procedure for classic classifications, and then retire the string. The label carries privacy, external access and sharing defaults; the string carries a word.",
              "message_degraded": false,
              "engine_detail": "",
              "attention": {
                "state": "none",
                "rank": 5,
                "because": [
                  "the rule does not apply to this resource"
                ]
              }
            }
