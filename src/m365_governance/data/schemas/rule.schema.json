{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph7x.com/schemas/m365-governance/rule/1.0.0",
  "title": "Governance rule",
  "description": "Structure only. This schema never follows a reference: everything it decides is decidable from a single field. Cross-field constraints belong to the semantic validator. See docs/JSON-SCHEMA-PLAN.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "service",
    "resource_type",
    "basis",
    "severity",
    "evidence_requirements",
    "condition",
    "outcomes",
    "limitations"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/versionString" },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,7}-[A-Z]+-[0-9]{3}$"
    },
    "version": { "$ref": "#/$defs/versionString" },
    "title": { "type": "string", "minLength": 10 },
    "description": { "type": "string", "minLength": 40 },
    "service": { "type": "string", "minLength": 2 },
    "resource_type": { "type": "string", "minLength": 2 },
    "basis": { "$ref": "#/$defs/basis" },
    "severity": { "$ref": "#/$defs/severity" },
    "applicability": { "$ref": "#/$defs/comparison" },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRequirement" }
    },
    "condition": { "$ref": "#/$defs/comparison" },
    "outcomes": { "$ref": "#/$defs/outcomes" },
    "remediation": { "type": "string", "minLength": 20 },
    "limitations": { "$ref": "#/$defs/limitations" }
  },

  "$defs": {
    "versionString": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Quoted in YAML. Unquoted 1.10 parses as the float 1.1."
    },

    "evidencePath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },

    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "requirement",
            "documented-limit",
            "documented-guidance",
            "convention",
            "opinion"
          ]
        },
        "limit": { "$ref": "#/$defs/limit" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "rationale": { "type": "string", "minLength": 40 }
      },
      "allOf": [
        {
          "$comment": "Documented types carry at least one source.",
          "if": {
            "properties": {
              "type": {
                "enum": ["requirement", "documented-limit", "documented-guidance"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["sources"],
            "properties": { "sources": { "minItems": 1 } }
          }
        },
        {
          "$comment": "convention and opinion carry a rationale. A source is optional.",
          "if": {
            "properties": { "type": { "enum": ["convention", "opinion"] } },
            "required": ["type"]
          },
          "then": { "required": ["rationale"] }
        },
        {
          "$comment": "documented-limit states the limit next to the observed value.",
          "if": {
            "properties": { "type": { "const": "documented-limit" } },
            "required": ["type"]
          },
          "then": { "required": ["limit"] }
        }
      ]
    },

    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "statement"],
      "properties": {
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 20 }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "publisher", "checked_at"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "title": { "type": "string", "minLength": 3 },
        "publisher": { "type": "string", "minLength": 2 },
        "checked_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },

    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "rationale"],
      "properties": {
        "default": { "enum": ["low", "medium", "high", "critical"] },
        "rationale": { "type": "string", "minLength": 40 },
        "configurable": { "type": "boolean" }
      }
    },

    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "required"],
      "properties": {
        "path": { "$ref": "#/$defs/evidencePath" },
        "type": {
          "enum": ["integer", "number", "boolean", "string", "array"]
        },
        "required": {
          "const": true,
          "$comment": "Optional evidence has no role in this version. Every declared path must be consumed, and every consumed path is required. See docs/POST-REVIEW-CHANGES.md item 3."
        }
      }
    },

    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "evidence"],
      "properties": {
        "operator": {
          "enum": [
            "equals", "not-equals",
            "less-than", "less-than-or-equal",
            "greater-than", "greater-than-or-equal",
            "contains", "not-contains",
            "exists", "not-exists",
            "in", "not-in"
          ]
        },
        "evidence": { "$ref": "#/$defs/evidencePath" },
        "value": {}
      },
      "allOf": [
        {
          "$comment": "exists and not-exists take no value. Everything else requires one.",
          "if": {
            "properties": { "operator": { "enum": ["exists", "not-exists"] } },
            "required": ["operator"]
          },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        }
      ]
    },

    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "unknown",
        "not_applicable",
        "invalid_evidence"
      ],
      "$comment": "error is absent on purpose: it describes the engine, not the resource, so a rule may not author its message.",
      "properties": {
        "pass": { "$ref": "#/$defs/outcomeMessage" },
        "fail": { "$ref": "#/$defs/outcomeMessage" },
        "unknown": { "$ref": "#/$defs/failureStateMessage" },
        "not_applicable": { "$ref": "#/$defs/failureStateMessage" },
        "invalid_evidence": { "$ref": "#/$defs/failureStateMessage" }
      }
    },

    "outcomeMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "type": "string", "minLength": 20 } }
    },

    "failureStateMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 20,
          "not": { "pattern": "\\{" },
          "$comment": "These three messages are printed precisely when the evidence is missing, out of scope or malformed. A field cannot be both the reason the rule could not decide and a value the rule prints. Purely lexical, so it belongs here rather than to the semantic validator."
        }
      }
    },

    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passes_without_resolving"],
      "properties": {
        "passes_without_resolving": { "type": "string", "minLength": 40 },
        "other": {
          "type": "array",
          "items": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
