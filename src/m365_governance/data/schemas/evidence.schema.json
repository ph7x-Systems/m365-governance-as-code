{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph7x.com/schemas/m365-governance/evidence/1.2.0",
  "title": "Evidence document",
  "description": "What a collector is allowed to hand to the engine. Structure only. See docs/EVIDENCE-SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "coverage",
    "resource",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "resource": {
      "$ref": "#/$defs/resource"
    },
    "facts": {
      "$ref": "#/$defs/factsMap"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_at",
        "collector",
        "collector_version",
        "source_system",
        "identity_kind"
      ],
      "properties": {
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "collector": {
          "type": "string",
          "minLength": 3
        },
        "collector_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source_system": {
          "type": "string",
          "minLength": 3
        },
        "source_api": {
          "type": "string",
          "minLength": 3
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_kind": {
          "enum": [
            "application",
            "delegated",
            "imported"
          ],
          "$comment": "A delegated run sees what one person sees. An imported one was not produced here at all: we did not choose its scope, we do not know what the exporting identity could read, and we cannot reproduce it. This field is the difference between a partial audit and a misleading one."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import_source": {
          "$ref": "#/$defs/importSource"
        }
      },
      "allOf": [
        {
          "$comment": "A live run knows which API it used, which tenant it read, and with what permissions.",
          "if": {
            "properties": {
              "identity_kind": {
                "enum": [
                  "application",
                  "delegated"
                ]
              }
            },
            "required": [
              "identity_kind"
            ]
          },
          "then": {
            "required": [
              "source_api",
              "tenant_id",
              "scopes"
            ],
            "not": {
              "required": [
                "import_source"
              ]
            }
          }
        },
        {
          "$comment": "An import has no scopes, and writing `scopes: []` would read as 'no permissions were needed' rather than 'this does not apply'. It carries who exported it instead.",
          "if": {
            "properties": {
              "identity_kind": {
                "const": "imported"
              }
            },
            "required": [
              "identity_kind"
            ]
          },
          "then": {
            "required": [
              "import_source"
            ],
            "not": {
              "required": [
                "scopes"
              ]
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "completed",
        "unavailable"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailable": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "detail"
            ],
            "properties": {
              "state": {
                "$ref": "#/$defs/absentState"
              },
              "detail": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "scope",
        "parent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 2
        },
        "display_name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "tenant",
            "collection",
            "container",
            "item"
          ],
          "description": "How far this resource's own settings reach. Deliberately about governance reach rather than a product's menu structure, so it holds across workloads: a SharePoint site, an Exchange mailbox and a Team are all `collection`; a list, a folder and a channel are all `container`. A model naming SharePoint's levels would need a second model at the second workload."
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "description": "The id of the resource that contains this one, or null where nothing does. Null is a real answer for a tenant and a defect anywhere else, which is why the field is required: an optional containment field is one that gets omitted, and then the relationship goes back into prose."
        }
      },
      "description": "What was observed, and where it sits. Containment is two explicit fields and never a substring of an identifier: an id is opaque by design, so reading a parent out of it would make every consumer parse a grammar that varies by workload."
    },
    "collectionState": {
      "enum": [
        "observed",
        "missing",
        "not-supported",
        "permission-denied",
        "partial",
        "invalid"
      ]
    },
    "absentState": {
      "enum": [
        "missing",
        "not-supported",
        "permission-denied",
        "partial"
      ]
    },
    "factsMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/factsNode"
      }
    },
    "factsNode": {
      "anyOf": [
        {
          "$ref": "#/$defs/scalarFact"
        },
        {
          "$ref": "#/$defs/aggregateFact"
        },
        {
          "$ref": "#/$defs/factsMap"
        }
      ]
    },
    "scalarFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/collectionState"
        },
        "value": {},
        "detail": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/raw"
        }
      },
      "allOf": [
        {
          "$comment": "An observed fact has a value. Absence has a reason, never a bare null.",
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "$comment": "Anything not observed says why.",
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "missing",
                  "not-supported",
                  "permission-denied",
                  "invalid"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "detail"
            ]
          }
        }
      ]
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      }
    },
    "aggregateFact": {
      "$comment": "A counted collection whose members may be groups. See docs/EVIDENCE-SCHEMA.md section 8.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "expansion_complete"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/collectionState"
        },
        "detail": {
          "type": "string"
        },
        "direct": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/principal"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/groupPrincipal"
          }
        },
        "expansion_complete": {
          "type": "boolean"
        },
        "effective_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_count": {
          "$ref": "#/$defs/scalarFact",
          "$comment": "How many members are individual principals. Separate from the total because it answers a different question: the total asks how many there are, this asks whether any of them is a person."
        },
        "group_count": {
          "$ref": "#/$defs/scalarFact"
        }
      },
      "allOf": [
        {
          "$comment": "Complete expansion produces an exact count and no lower bound.",
          "if": {
            "properties": {
              "expansion_complete": {
                "const": true
              }
            },
            "required": [
              "expansion_complete"
            ]
          },
          "then": {
            "required": [
              "effective_count"
            ],
            "not": {
              "required": [
                "minimum_count"
              ]
            }
          }
        },
        {
          "$comment": "Incomplete expansion produces a lower bound and never an exact count.",
          "if": {
            "properties": {
              "expansion_complete": {
                "const": false
              }
            },
            "required": [
              "expansion_complete"
            ]
          },
          "then": {
            "required": [
              "minimum_count"
            ],
            "not": {
              "required": [
                "effective_count"
              ]
            }
          }
        }
      ]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "principal_type"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "principal_type": {
          "enum": [
            "user",
            "group",
            "service-principal"
          ]
        }
      }
    },
    "groupPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "principal_type",
        "expansion"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "principal_type": {
          "const": "group"
        },
        "expansion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "incomplete",
                "not-attempted"
              ]
            },
            "member_count": {
              "type": "integer",
              "minimum": 0
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    },
    "importSource": {
      "$comment": "Named so that a reader can go back to the person who ran the export. Every field here is something the engine cannot check and a person can.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "exported_at"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 2
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "exported_by": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
